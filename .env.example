TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_ALIASES=
ADMIN_TELEGRAM_IDS=
ALLOWED_GROUPS=
DM_POLICY=admin
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
MAX_ROUNDS=5
TAVILY_API_KEY=
DATA_DIR=data
PERSONA_PATH=config/persona.prompt.md
GROUP_REPLY_MODE=all
HISTORY_LIMIT=40
HISTORY_MAX_CHARS=16000
MAX_INPUT_CHARS=6000
MAX_REPLY_CHARS=3500
MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_MS=30000
MAX_CONCURRENT_AI=3
MAX_QUEUE_PER_THREAD=10
MAX_QUEUE_TOTAL=100
MAX_QUEUE_WAIT_MS=90000
USER_MESSAGES_PER_MINUTE=10

# Giữ telegram cho cấu hình cũ. Dùng messenger hoặc telegram,messenger khi thử Page.
ENABLED_CHANNELS=telegram
# ID số của Page và Page Access Token từ app đã kết nối
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# App Secret ký webhook. Verify Token là chuỗi ngẫu nhiên tự đặt trên cả hai bên.
FB_APP_SECRET=
FB_VERIFY_TOKEN=
# Phiên bản Graph API đã đối chiếu
GRAPH_API_VERSION=v27.0
# Các PSID admin của chính Page này, ngăn bằng dấu phẩy
ADMIN_PSIDS=
# URL HTTPS gốc, ví dụ https://bot.example.com
PUBLIC_BASE_URL=
# Cổng nội bộ của Fastify
PORT=3000
# Bật khi Page có quyền dùng One-time Notification
FB_OTN_ENABLED=false

# ===== Vận hành (Giai đoạn 5) =====
# Bật tự trả lời bình luận bài viết của Page (cần đăng ký trường webhook "feed").
FB_COMMENTS_ENABLED=false
# Chỉ bật khi Meta đã cấp tính năng Human Agent: cho phép admin trả lời từ dashboard tới 7 ngày sau tin cuối của khách.
FB_HUMAN_AGENT_ENABLED=false
# Số phút bot tạm dừng khi chuyển cho người thật, sau đó tự bật lại.
HANDOFF_MINUTES=60
# Model chuyển giọng nói thành văn bản (OpenAI: whisper-1 / gpt-4o-mini-transcribe).
STT_MODEL=whisper-1
# sqlite (mặc định, dữ liệu trong data/bot.sqlite) hoặc file (cách lưu JSON cũ).
STORAGE=sqlite
# Mức log: trace | debug | info | warn | error
LOG_LEVEL=info
# Giá USD ước tính cho 1 triệu token, dùng để tính chi phí trên dashboard.
AI_COST_PER_MTOKEN=0.3
# Mật khẩu dashboard admin tại PUBLIC_BASE_URL/dashboard (>= 12 ký tự). Để trống = tắt dashboard.
DASHBOARD_PASSWORD=
# (Tuỳ chọn) khoá ký cookie dashboard; để trống sẽ tự suy ra từ mật khẩu.
DASHBOARD_SECRET=
# Hiển thị trên trang /privacy (Meta yêu cầu khi App Review).
PRIVACY_OWNER=
PRIVACY_CONTACT=
# Tên miền cho Caddy (docker-compose) để tự cấp HTTPS, ví dụ bot.example.com
DOMAIN=
