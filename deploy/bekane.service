[Unit]
Description=Bekane AI bot (Telegram + Messenger)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/bekane
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --max-old-space-size=320 /opt/bekane/dist/index.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bekane/data
MemoryMax=512M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
