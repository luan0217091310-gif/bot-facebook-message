{
  "name": "bekane-telegram-ai-agent",
  "version": "1.0.0",
  "description": "Bekane Bot — Telegram AI Agent đa năng (Multimodal Vision, Tool Calling, Scoped Memory, Web Search, Reminders & Website Watcher) của Phùng Hữu Luân",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "messenger:setup": "tsx src/setup.ts",
    "data:migrate": "tsx scripts/migrate-data.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "ipaddr.js": "^2.5.0",
    "mammoth": "^1.13.0",
    "node-telegram-bot-api": "^2.4.0",
    "openai": "^7.55.0",
    "pdfjs-dist": "^5.4.624",
    "pino": "^10.4.0",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-telegram-bot-api": "^0.64.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
